# Ignore files
/.htaccess
*.html

# Ignore directories 
cache
vendor

# Custom
custom/history/
custom/working/
custom/modules/*/Ext/
custom/application/Ext/*
!custom/application/Ext/Api
custom/Extension/application/Ext/Language/*

# JSON config
custom/json_files/**/*.json
custom/jssip_webrtc/blacklist.json

# Custom configuration should also be ignored.
/config.php
/config_override.php

# Logs files can safely be ignored.
*.log

# Ignore the new upload directories.
/upload/*
!/upload/index.html
/upload_backup/

# Images
themes/SuiteP/images/zalo_messages/*
!themes/SuiteP/images/zalo_messages/.gitkeep

# Modules
modules/EC_Zalo/nohup.out

# Ignore local system
.vscode
.DS_Store

# Claude configurations
CLAUDE.local.md
.claude/settings.local.json
